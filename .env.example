# ── Database ──────────────────────────────────────────────────────────────────
# Neon Postgres — get from console.neon.tech or Vercel Marketplace
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Payload ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
PAYLOAD_SECRET="your-secret-here-min-32-chars"

# ── Vercel Blob ────────────────────────────────────────────────────────────────
# Get from Vercel dashboard → Storage → Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ── Site ───────────────────────────────────────────────────────────────────────
# Used for metadataBase, sitemap.xml, robots.txt, and JSON-LD absolute URLs (include https://)
NEXT_PUBLIC_SITE_URL="https://thebusinessbarn.ca"

# ── Email (optional) ───────────────────────────────────────────────────────────
# For Payload lead notification emails
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
LEADS_NOTIFY_EMAIL="hello@businessbarn.ca"
