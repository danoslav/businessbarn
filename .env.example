# ── Database ──────────────────────────────────────────────────────────────────
# Neon Postgres — get from console.neon.tech or Vercel Marketplace
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Payload ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
PAYLOAD_SECRET="your-secret-here-min-32-chars"

# ── Vercel Blob ────────────────────────────────────────────────────────────────
# Get from Vercel dashboard → Storage → Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ── Site ───────────────────────────────────────────────────────────────────────
# Used for metadataBase, sitemap.xml, robots.txt, and JSON-LD absolute URLs (include https://)
NEXT_PUBLIC_SITE_URL="https://thebusinessbarn.ca"

# ── Google Analytics 4 ───────────────────────────────────────────────────────────
# Public measurement ID (safe in client bundle). Set the same in Vercel → Environment Variables.
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-JQHW5MCTEG"
# For Payload lead notification emails
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
LEADS_NOTIFY_EMAIL="hello@businessbarn.ca"
